# Public HTTP URL of the deployed backend service. Do not use the MySQL port here.
VITE_API_ROOT_URL=https://tailoring-shop-backend.up.railway.app

# Optional: override the customer API path if it differs from /api/customer.
VITE_API_BASE_URL=https://tailoring-shop-backend.up.railway.app/api/customer

# Optional: use a different backend URL for stitching-order endpoints.
VITE_STITCHING_API_BASE_URL=https://tailoring-shop-backend.up.railway.app